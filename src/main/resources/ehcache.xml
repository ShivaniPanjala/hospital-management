<ehcache>
    <diskStore path="java.io.tmpdir"/>

    <defaultCache
            maxEntriesLocalHeap="1000"
            eternal="false"
            timeToIdleSeconds="300"
            timeToLiveSeconds="600"
            overflowToDisk="false"
            statistics="true" />

    <!-- Example entity cache -->
    <cache name="com.example.Employee"
           maxEntriesLocalHeap="500"
           timeToLiveSeconds="600"
           eternal="false"
           statistics="true" />
</ehcache>
